[Unit]
Description=MasterPi local openWakeWord listener
After=default.target
ConditionPathExists=/home/pi/projs/hiwonder_masterpi/masterpi/models/openwakeword/hello_hibot.onnx
ConditionPathExists=/home/pi/projs/hiwonder_masterpi/masterpi/models/openwakeword/melspectrogram.onnx
ConditionPathExists=/home/pi/projs/hiwonder_masterpi/masterpi/models/openwakeword/embedding_model.onnx
ConditionPathExists=/home/pi/projs/hiwonder_masterpi/masterpi/assets/im-here.wav

[Service]
Type=simple
WorkingDirectory=/home/pi/projs/hiwonder_masterpi/masterpi
Environment=PYTHONPATH=/home/pi/projs/hiwonder_masterpi/masterpi/src
Environment=HOME=/home/pi
EnvironmentFile=-/home/pi/.config/masterpi/openai.env
EnvironmentFile=-/home/pi/projs/hiwonder_masterpi/.env
ExecStart=/home/pi/projs/hiwonder_masterpi/masterpi/.wakeword-venv/bin/python -m masterpi_control.wake_word --conversation --conversation-backend realtime --realtime-model gpt-realtime-2.1 --threshold 0.5 --speech-threshold 400 --speech-silence 3 --speech-start-timeout 15 --followup-timeout 8 --max-utterance 30 --conversation-max-turns 30 --max-silent-cycles 2 --no-barge-in
Restart=on-failure
RestartPreventExitStatus=2
RestartSec=2

[Install]
WantedBy=default.target
